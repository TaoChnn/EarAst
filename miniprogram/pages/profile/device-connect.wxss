.device-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 28rpx calc(52rpx + env(safe-area-inset-bottom));
  background: #f6f8fb;
}

.device-hero {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 590rpx;
  padding: 52rpx 40rpx 46rpx;
  border: 2rpx solid rgba(115, 137, 177, 0.1);
  border-radius: 42rpx;
  background: linear-gradient(145deg, #f9fbff 0%, #edf5ff 58%, #f5f9ff 100%);
  box-shadow: 0 20rpx 54rpx rgba(62, 81, 113, 0.07);
  text-align: center;
}

.device-page--connected .device-hero {
  min-height: 520rpx;
  background: linear-gradient(145deg, #f8fbff 0%, #eaf4ff 58%, #f3f8ff 100%);
}

.hero-shape {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-shape--one {
  top: -120rpx;
  right: -74rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(160, 184, 223, 0.12);
  animation: hero-shape-drift-one 9s ease-in-out infinite;
}

.hero-shape--two {
  bottom: -120rpx;
  left: -96rpx;
  width: 300rpx;
  height: 300rpx;
  border: 42rpx solid rgba(124, 171, 220, 0.075);
  animation: hero-shape-drift-two 11s ease-in-out infinite;
}

/* 连接成功后卡片变成“动态”：圆圈漂移更快更明显 */
.device-page--connected .hero-shape--one {
  animation-duration: 5.5s;
}

.device-page--connected .hero-shape--two {
  animation-duration: 6.5s;
}

.device-visual {
  position: relative;
  display: flex;
  width: 242rpx;
  height: 242rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
}

.signal-ring {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid rgba(108, 135, 176, 0.13);
  border-radius: 999rpx;
}

.signal-ring--outer {
  width: 242rpx;
  height: 242rpx;
}

.signal-ring--inner {
  width: 188rpx;
  height: 188rpx;
  background: rgba(255, 255, 255, 0.3);
}

.device-visual--working .signal-ring--outer {
  animation: signal-pulse 1.5s ease-out infinite;
}

.device-visual--working .signal-ring--inner {
  animation: signal-pulse 1.5s 0.35s ease-out infinite;
}

.device-core {
  position: relative;
  z-index: 2;
  display: flex;
  width: 132rpx;
  height: 132rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(101, 125, 166, 0.13);
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 40rpx rgba(65, 84, 117, 0.11);
}

.device-core-icon {
  width: 70rpx;
  height: 70rpx;
}

.device-led {
  position: absolute;
  right: 18rpx;
  bottom: 17rpx;
  box-sizing: border-box;
  width: 15rpx;
  height: 15rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #a8b1be;
}

.device-page--found .device-led,
.device-page--connected .device-led {
  background: #0066cc;
  box-shadow: 0 0 0 7rpx rgba(0, 102, 204, 0.12);
}

.device-page--scanning .device-core-icon,
.device-page--connecting .device-core-icon {
  animation: soft-breathe 1.4s ease-in-out infinite;
}

.hero-eyebrow {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #71819c;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.hero-status-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: #8e9cb3;
}

.device-page--connected .hero-eyebrow {
  color: #0066cc;
}

.device-page--connected .hero-status-dot {
  background: #0066cc;
}

.hero-title {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  color: #202a39;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
  letter-spacing: -1rpx;
}

.hero-description {
  position: relative;
  z-index: 2;
  max-width: 540rpx;
  margin: 18rpx auto 0;
  color: #76808d;
  font-size: 26rpx;
  line-height: 1.55;
}

.found-card,
.device-info-card,
.capability-card,
.device-details {
  box-sizing: border-box;
  border: 2rpx solid rgba(112, 130, 158, 0.1);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 32rpx rgba(64, 78, 101, 0.045);
}

.found-card {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 28rpx;
}

.found-device-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #f1f4f9;
}

.found-device-icon image {
  width: 42rpx;
  height: 42rpx;
}

.found-device-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.found-device-name {
  color: #253042;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.3;
}

.found-device-meta {
  margin-top: 6rpx;
  color: #8a929e;
  font-size: 22rpx;
  line-height: 1.3;
}

.signal-bars {
  display: flex;
  height: 30rpx;
  flex-shrink: 0;
  align-items: flex-end;
  margin-left: 16rpx;
}

.signal-bar {
  width: 5rpx;
  margin-left: 5rpx;
  border-radius: 5rpx;
  background: #4d8fd3;
}

.signal-bar--one { height: 10rpx; }
.signal-bar--two { height: 19rpx; }
.signal-bar--three { height: 28rpx; }

.capability-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 32rpx;
}

.capability-heading,
.section-heading {
  color: #273142;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.3;
}

.capability-list {
  margin-top: 14rpx;
}

.capability-item {
  display: flex;
  align-items: center;
  padding: 21rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.capability-item--last {
  border-bottom: 0;
  padding-bottom: 5rpx;
}

.capability-icon {
  position: relative;
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.capability-icon--noise { background: #eaf3fd; }
.capability-icon--time { background: #edf5ff; }
.capability-icon--volume { background: #f0f6fc; }

.wave-line {
  width: 4rpx;
  margin: 0 3rpx;
  border-radius: 4rpx;
  background: #7089ad;
}

.wave-line--one { height: 15rpx; }
.wave-line--two { height: 28rpx; }
.wave-line--three { height: 20rpx; }

.clock-hand {
  position: absolute;
  left: 31rpx;
  bottom: 31rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background: #5c86b3;
  transform-origin: 50% 100%;
}

.clock-hand--hour { height: 14rpx; transform: rotate(0deg); }
.clock-hand--minute { height: 19rpx; transform: rotate(118deg); }

.capability-icon--time::after {
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #5c86b3;
  border-radius: 999rpx;
  content: "";
}

.volume-pillar {
  width: 5rpx;
  margin: 0 3rpx;
  border-radius: 5rpx;
  background: #718ba8;
}

.volume-pillar--one { height: 13rpx; }
.volume-pillar--two { height: 25rpx; }
.volume-pillar--three { height: 34rpx; }

.capability-copy {
  min-width: 0;
  margin-left: 20rpx;
}

.capability-title {
  color: #344052;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.3;
}

.capability-desc {
  margin-top: 5rpx;
  color: #8b939f;
  font-size: 22rpx;
  line-height: 1.35;
}

.connected-content {
  margin-top: 22rpx;
}

.device-info-card {
  display: flex;
  align-items: center;
  padding: 27rpx 28rpx;
  border-radius: 28rpx;
}

.device-info-main {
  flex: 1;
  min-width: 0;
}

.device-info-label,
.metric-label,
.detail-label {
  color: #8a929e;
  font-size: 22rpx;
  line-height: 1.3;
}

.device-info-value {
  display: flex;
  align-items: center;
  margin-top: 7rpx;
  color: #334052;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.online-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 11rpx;
  border-radius: 999rpx;
  background: #0066cc;
  box-shadow: 0 0 0 7rpx rgba(0, 102, 204, 0.1);
}

.battery-wrap {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  color: #617b98;
  font-size: 23rpx;
  font-weight: 600;
}

.battery-shell {
  position: relative;
  box-sizing: border-box;
  width: 40rpx;
  height: 20rpx;
  margin-right: 9rpx;
  padding: 3rpx;
  border: 2rpx solid #7f9ab7;
  border-radius: 5rpx;
}

.battery-shell::after {
  position: absolute;
  top: 5rpx;
  right: -6rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 0 3rpx 3rpx 0;
  background: #7f9ab7;
  content: "";
}

.battery-level {
  width: 86%;
  height: 100%;
  border-radius: 2rpx;
  background: #3b82c4;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 6rpx 16rpx;
}

.section-heading-meta {
  color: #969da7;
  font-size: 21rpx;
  font-weight: 400;
}

.metrics-grid {
  display: flex;
  gap: 12rpx;
}

.metric-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: 25rpx 18rpx 23rpx;
  border: 2rpx solid rgba(114, 133, 160, 0.08);
  border-radius: 25rpx;
  background: #ffffff;
}

.metric-accent {
  position: absolute;
  top: 0;
  right: 0;
  width: 66rpx;
  height: 66rpx;
  border-radius: 0 0 0 66rpx;
  opacity: 0.68;
}

.metric-card--blue .metric-accent { background: #dcecff; }
.metric-card--sky .metric-accent { background: #e5f3ff; }
.metric-card--slate .metric-accent { background: #e8eef5; }

.metric-value-row {
  display: flex;
  align-items: baseline;
  margin-top: 15rpx;
  white-space: nowrap;
}

.metric-value {
  color: #2e3949;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1rpx;
}

.metric-unit {
  margin-left: 5rpx;
  color: #7c8591;
  font-size: 19rpx;
}

.device-details {
  margin-top: 22rpx;
  padding: 4rpx 28rpx;
  border-radius: 28rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  border-bottom: 2rpx solid #f1f3f5;
}

.detail-row--last { border-bottom: 0; }

.detail-value {
  color: #4a5564;
  font-size: 23rpx;
  line-height: 1.3;
}

.device-actions {
  margin-top: 26rpx;
}

.primary-action,
.disconnect-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  border: 0;
}

.primary-action::after,
.disconnect-action::after {
  border: 0;
}

.primary-action {
  height: 98rpx;
  border-radius: 27rpx;
  background: var(--color-ink);
  box-shadow: 0 14rpx 30rpx rgba(29, 29, 31, 0.16);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 98rpx;
}

.device-page--connected .primary-action {
  background: var(--color-ink);
  box-shadow: 0 14rpx 30rpx rgba(29, 29, 31, 0.16);
}

.primary-action--pressed { opacity: 0.86; }

.primary-action--disabled {
  background: rgba(29, 29, 31, 0.5);
  box-shadow: none;
  opacity: 0.72;
}

.action-spinner {
  box-sizing: border-box;
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 999rpx;
  animation: spin 0.85s linear infinite;
}

.disconnect-action {
  height: 84rpx;
  margin-top: 14rpx;
  border: 2rpx solid rgba(185, 103, 110, 0.12);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.66);
  color: #b46d73;
  font-size: 26rpx;
  line-height: 84rpx;
}

.demo-note {
  margin-top: 20rpx;
  color: #a0a6af;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

@keyframes signal-pulse {
  0% { opacity: 0.75; transform: scale(0.88); }
  75%, 100% { opacity: 0; transform: scale(1.12); }
}

@keyframes soft-breathe {
  0%, 100% { opacity: 0.65; transform: scale(0.96); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes hero-shape-drift-one {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-28rpx, 22rpx) scale(1.05); }
}

@keyframes hero-shape-drift-two {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(22rpx, -26rpx) scale(1.04); }
}
