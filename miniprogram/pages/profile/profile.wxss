/* 个人中心 */
.profile-page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--spacing-sm) var(--spacing-md)
    calc(100rpx + env(safe-area-inset-bottom) + var(--spacing-lg));
  background: var(--color-canvas-parchment);
}

.profile-content {
  width: 100%;
}

.profile-title {
  color: var(--color-ink);
  font-size: var(--text-display-md);
  font-weight: 700;
  line-height: var(--leading-display);
  margin-bottom: var(--spacing-sm);
}

.user-summary {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 260rpx;
  padding: var(--spacing-lg) var(--spacing-sm);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.user-summary--pressed {
  background: var(--color-surface-pearl);
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--color-hairline);
  background: var(--color-canvas);
  border-radius: var(--radius-full);
  box-sizing: border-box;
}

.user-copy {
  flex: 1;
  min-width: 0;
  margin-left: var(--spacing-sm);
}

.user-nickname {
  color: var(--color-ink);
  font-size: var(--text-tagline);
  font-weight: 600;
  line-height: 1.2;
}

.user-bio {
  overflow: hidden;
  color: var(--color-ink-muted-48);
  font-size: var(--text-body);
  line-height: 1.35;
  margin-top: var(--spacing-xxs);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-device {
  overflow: hidden;
  margin-top: var(--spacing-xs);
  color: var(--color-ink-muted-80);
  font-size: var(--text-body-strong);
  font-weight: 500;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-summary-chevron {
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  opacity: 0.4;
}

/* 游客提示条 */
.guest-banner {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm);
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.guest-copy {
  flex: 1;
  min-width: 0;
}

.guest-title {
  color: var(--color-ink);
  font-size: var(--text-body-strong);
  font-weight: 600;
  line-height: 1.3;
}

.guest-desc {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: 1.45;
}

.guest-login {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  padding: 12rpx 36rpx;
  border-radius: var(--radius-pill);
  background: var(--color-brand, #0066cc);
  color: #ffffff;
  font-size: var(--text-body);
  line-height: 1.2;
}

.guest-login--pressed {
  opacity: 0.85;
}

.stats-card {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  min-height: 216rpx;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
  border: 2rpx solid var(--color-divider-soft);
  border-radius: var(--radius-lg);
  background: var(--color-canvas);
}

.stat-item {
  position: relative;
  display: flex;
  flex: 1 1 0;
  width: 33.333%;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xs);
  box-sizing: border-box;
}

.stat-item--pressed {
  background: var(--color-surface-pearl);
}

.stat-item--divided::after {
  position: absolute;
  top: var(--spacing-md);
  right: 0;
  bottom: var(--spacing-md);
  width: 2rpx;
  background: var(--color-hairline);
  opacity: 0.42;
  content: "";
}

.stat-value {
  color: var(--color-ink);
  font-size: var(--text-lead);
  font-weight: 700;
  line-height: var(--leading-display);
}

.stat-label {
  margin-top: var(--spacing-xxs);
  color: var(--color-ink-muted-48);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
  white-space: nowrap;
}

/* 设备入口：作为独立能力卡片，与常规设置菜单区分开 */
.device-entry {
  position: relative;
  display: flex;
  overflow: hidden;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 196rpx;
  margin-top: var(--spacing-sm);
  padding: 30rpx var(--spacing-sm);
  border: 2rpx solid rgba(111, 136, 181, 0.13);
  border-radius: var(--radius-lg);
  background: linear-gradient(128deg, #f8faff 0%, #f3f6fb 54%, #faf8fc 100%);
  box-shadow: 0 12rpx 36rpx rgba(65, 83, 117, 0.055);
}

.device-entry--connected {
  border-color: rgba(0, 102, 204, 0.15);
  background: linear-gradient(128deg, #f7faff 0%, #eef6ff 58%, #f8faff 100%);
}

.device-entry--pressed {
  opacity: 0.82;
}

.device-entry-orb {
  position: absolute;
  border-radius: var(--radius-full);
  pointer-events: none;
}

.device-entry-orb--one {
  top: -88rpx;
  right: 54rpx;
  width: 208rpx;
  height: 208rpx;
  background: rgba(166, 188, 227, 0.12);
  animation: device-orb-drift-one 8s ease-in-out infinite;
}

.device-entry-orb--two {
  right: -48rpx;
  bottom: -68rpx;
  width: 150rpx;
  height: 150rpx;
  border: 22rpx solid rgba(191, 175, 211, 0.09);
  animation: device-orb-drift-two 10s ease-in-out infinite;
}

/* 连接设备后卡片变成“动态”：圆圈漂移更快更明显 */
.device-entry--connected .device-entry-orb--one {
  animation-duration: 5s;
}

.device-entry--connected .device-entry-orb--two {
  animation-duration: 6s;
}

.device-entry-icon-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(109, 132, 174, 0.11);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 8rpx 20rpx rgba(75, 92, 121, 0.06);
}

.device-entry-icon {
  width: 52rpx;
  height: 52rpx;
}

.device-entry-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.device-entry-title-row {
  display: flex;
  align-items: center;
}

.device-entry-title {
  color: #273142;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.25;
}

.device-entry-badge {
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 5rpx 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(105, 129, 173, 0.09);
  color: #7282a0;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.25;
}

.device-entry-desc {
  overflow: hidden;
  margin-top: 9rpx;
  color: #7c8491;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-entry-status {
  display: flex;
  align-items: center;
  margin-top: 13rpx;
  color: #8a92a0;
  font-size: 22rpx;
  line-height: 1.3;
}

.device-entry-dot {
  width: 11rpx;
  height: 11rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
  border-radius: var(--radius-full);
  background: #a8b0bd;
}

.device-entry--connected .device-entry-dot {
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(0, 102, 204, 0.12);
  animation: device-dot-pulse 2.2s ease-in-out infinite;
}

.device-entry--connected .device-entry-status {
  color: var(--color-primary);
}

.device-entry-chevron {
  position: relative;
  z-index: 1;
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: var(--spacing-xs);
  opacity: 0.34;
}

.profile-actions {
  margin-top: var(--spacing-sm);
}

.menu-group + .menu-group {
  margin-top: 20rpx;
}

.menu-group {
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--color-divider-soft);
  background: var(--color-canvas);
  border-radius: var(--radius-lg);
}

.menu-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: var(--spacing-xs) var(--spacing-sm);
  box-sizing: border-box;
}

.menu-row--pressed {
  background: var(--color-surface-pearl);
}

.menu-row--divided::after {
  position: absolute;
  right: var(--spacing-sm);
  bottom: 0;
  left: calc(var(--spacing-sm) + 76rpx + var(--spacing-sm));
  height: 2rpx;
  background: var(--color-hairline);
  opacity: 0.55;
  content: "";
}

.menu-icon-box {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: rgba(0, 102, 204, 0.07);
  margin-right: var(--spacing-sm);
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.menu-title {
  flex: 1;
  min-width: 0;
  color: var(--color-ink);
  font-size: var(--text-button-large);
  font-weight: 500;
  line-height: var(--leading-body);
  margin-right: var(--spacing-sm);
}

.menu-chevron {
  width: 18rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: auto;
  opacity: 0.4;
}

@keyframes device-orb-drift-one {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-20rpx, 16rpx) scale(1.06); }
}

@keyframes device-orb-drift-two {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(16rpx, -18rpx) scale(1.05); }
}

@keyframes device-dot-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(0, 102, 204, 0.12); }
  50% { box-shadow: 0 0 0 11rpx rgba(0, 102, 204, 0.05); }
}
