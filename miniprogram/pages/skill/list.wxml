<view class="skill-page">
  <!-- 来源切换（iOS 分段控件） -->
  <view class="source-switch" role="tablist" aria-label="技能来源">
    <view
      class="source-tab {{activeSource === item.key ? 'source-tab--active' : ''}}"
      wx:for="{{sourceTabs}}"
      wx:key="key"
      role="tab"
      aria-selected="{{activeSource === item.key}}"
      data-source="{{item.key}}"
      bindtap="onSelectSource"
    >{{item.label}}</view>
  </view>

  <!-- ============ 官方指南 ============ -->
  <block wx:if="{{activeSource === 'developer'}}">
    <!-- 官方内容主视觉：图片与文案组成一张完整的 Apple 式内容卡 -->
    <view class="guide-hero">
      <image
        class="guide-hero__art"
        src="/images/skill/hearing-guide-hero.svg"
        mode="aspectFill"
        aria-label="耳朵与声波组成的护耳主题插画"
      ></image>
      <view class="guide-hero__content">
        <view class="guide-hero__eyebrow">听力健康指南</view>
        <view class="guide-hero__title">好好听，也好好保护。</view>
        <view class="guide-hero__desc">从音量、时长到日常习惯，用简单的方法守住每一次聆听。</view>
        <view class="guide-hero__meta">{{developerTotal}} 篇专业指南</view>
      </view>
    </view>

    <!-- 分类筛选 -->
    <view class="section-heading">
      <view class="section-title">探索指南</view>
      <view class="section-count">{{developerSkills.length}} 篇</view>
    </view>
    <scroll-view class="chip-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="chip-list">
        <view
          class="chip {{activeCategory === item.key ? 'chip--selected' : ''}}"
          wx:for="{{categories}}"
          wx:key="key"
          data-category="{{item.key}}"
          bindtap="onSelectCategory"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <!-- 技能列表 -->
    <view class="guide-list" wx:if="{{developerSkills.length}}">
      <view
        class="guide-row"
        wx:for="{{developerSkills}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTapSkill"
        hover-class="guide-row--hover"
      >
        <view class="guide-row__main">
          <view class="guide-row__category">{{item.category}}</view>
          <view class="guide-row__title">{{item.title}}</view>
          <view class="guide-row__summary">{{item.summary}}</view>
          <view class="guide-row__meta">{{item.readMinutes}} 分钟阅读</view>
        </view>
        <view class="guide-row__arrow">›</view>
      </view>
    </view>

    <view class="legal-note">官方内容为健康科普整理，不替代医生诊断或治疗建议。</view>
  </block>

  <!-- ============ 耳友妙招 ============ -->
  <block wx:else>
    <view class="inline-tip" wx:if="{{communityLoading}}">正在加载耳友分享…</view>

    <block wx:if="{{!communityLoading && communitySkills.length}}">
      <view class="list-caption">来自耳友圈「护耳妙招」板块，点击查看原帖</view>
      <view class="group-list">
        <view
          class="group-row"
          wx:for="{{communitySkills}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="onTapCommunityPost"
          hover-class="group-row--hover"
        >
          <image class="post-avatar" src="{{item.avatar || defaultAvatar}}" mode="aspectFill"></image>
          <view class="row-main">
            <!-- UGC 不依赖标题：标题为空时回退到内容摘要，feed 式单文本 -->
            <view class="row-text">{{item.title || item.summary || '分享了一张图片'}}</view>
            <view class="row-meta">{{item.nickname}} · {{item.createTime}}</view>
            <view class="row-meta row-meta--stats">{{item.likeCount}} 赞 · {{item.commentCount}} 评论</view>
          </view>
          <image class="post-cover" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"></image>
        </view>
      </view>
    </block>

    <view class="empty-tip" wx:if="{{!communityLoading && !communitySkills.length}}">
      <view class="empty-title">{{communityError ? '耳友妙招加载失败' : '还没有耳友分享'}}</view>
      <view class="empty-desc">{{communityError ? '请检查云环境部署后重试，或先浏览官方指南。' : '去耳友圈「护耳妙招」板块发布第一条分享吧～'}}</view>
    </view>

    <view class="legal-note">耳友分享属于个人经验，不替代医生建议或专业听力检查。</view>
  </block>
</view>
