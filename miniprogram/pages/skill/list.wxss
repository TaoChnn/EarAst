/* 护耳技能库 页面样式 —— Apple 简约风：白底、发丝线分组列表、单一交互色 */

.skill-page {
  min-height: 100vh;
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
  background: var(--color-canvas-parchment);
}

/* 来源切换（iOS 分段控件） */
.source-switch {
  display: flex;
  margin: var(--spacing-sm) var(--spacing-md) var(--spacing-md);
  padding: 4rpx;
  border-radius: var(--radius-pill);
  background: #e8e8ed;
}

/* 官方指南主视觉：上图下文，避免在艺术图上压文字，移动端更清晰 */
.guide-hero {
  margin: 0 var(--spacing-md) var(--spacing-lg);
  overflow: hidden;
  border-radius: 44rpx;
  background: var(--color-canvas);
  box-shadow: 0 8rpx 32rpx rgba(29, 29, 31, 0.06);
}

.guide-hero__art {
  display: block;
  width: 100%;
  height: 330rpx;
  background: #edf4ff;
}

.guide-hero__content {
  padding: 34rpx 36rpx 38rpx;
}

.guide-hero__eyebrow {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.guide-hero__title {
  margin-top: 10rpx;
  color: var(--color-ink);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.guide-hero__desc {
  margin-top: 14rpx;
  color: var(--color-ink-muted-48);
  font-size: 27rpx;
  line-height: 1.55;
}

.guide-hero__meta {
  margin-top: 20rpx;
  color: var(--color-ink-muted-80);
  font-size: 22rpx;
  font-weight: 500;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 var(--spacing-md) 4rpx;
}

.section-title {
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.6rpx;
}

.section-count {
  color: var(--color-ink-muted-48);
  font-size: 22rpx;
}

.source-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-pill);
  color: var(--color-ink);
  font-size: var(--text-button-utility);
  font-weight: 500;
  text-align: center;
}

.source-tab--active {
  background: var(--color-canvas);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 分类筛选 chips（与上方分段控件同款处理：选中白底浮起，未选中透明融入底色） */
.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-list {
  display: inline-flex;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-md) var(--spacing-md);
}

.chip {
  height: 60rpx;
  line-height: 60rpx;
  flex-shrink: 0;
  padding: 0 var(--spacing-md);
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.62);
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  font-weight: 400;
}

.chip--selected {
  background: var(--color-ink);
  color: var(--color-on-primary);
  font-weight: 600;
  box-shadow: none;
}

/* 官方指南卡片：每篇文章独立成卡，扫读层级比连续表格更清楚 */
.guide-list {
  margin: 0 var(--spacing-md);
}

.guide-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
  padding: 30rpx 30rpx 28rpx;
  border-radius: 32rpx;
  background: var(--color-canvas);
  transition: transform 0.15s ease, background 0.15s ease;
}

.guide-row--hover {
  background: var(--color-surface-pearl);
  transform: scale(0.985);
}

.guide-row__main {
  flex: 1;
  min-width: 0;
}

.guide-row__category {
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
}

.guide-row__title {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.32;
  letter-spacing: -0.5rpx;
}

.guide-row__summary {
  margin-top: 10rpx;
  color: var(--color-ink-muted-48);
  font-size: 25rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.guide-row__meta {
  margin-top: 14rpx;
  color: var(--color-ink-muted-48);
  font-size: 20rpx;
}

.guide-row__arrow {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-left: 18rpx;
  border-radius: 50%;
  background: var(--color-canvas-parchment);
  color: var(--color-ink-muted-48);
  font-size: 32rpx;
  font-weight: 300;
  line-height: 40rpx;
  text-align: center;
}

/* 行级差异样式（基础 .group-list/.group-row/.row-* 见 app.wxss） */
.row-meta--stats {
  margin-top: var(--spacing-xxs);
}

/* 耳友妙招：feed 式单文本（同耳友圈广场风格，不区分标题/摘要） */
.row-text {
  color: var(--color-ink);
  font-size: var(--text-caption);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 耳友妙招行内的头像与封面 */
.post-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-full);
  background: var(--color-surface-pearl);
}

.post-cover {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  margin-left: var(--spacing-sm);
  border-radius: var(--radius-sm);
  background: var(--color-surface-pearl);
}

.list-caption {
  margin: 0 var(--spacing-md) var(--spacing-sm);
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
}

/* 加载 / 空状态 / 法律声明：安静的小字，不加框 */
.inline-tip {
  padding: var(--spacing-xl) 0;
  text-align: center;
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
}

.empty-tip {
  padding: var(--spacing-xxl) var(--spacing-lg);
  text-align: center;
}

.empty-title {
  color: var(--color-ink);
  font-size: var(--text-caption-strong);
  font-weight: 600;
}

.empty-desc {
  max-width: 520rpx;
  margin: var(--spacing-xs) auto 0;
  color: var(--color-ink-muted-48);
  font-size: var(--text-fine-print);
  line-height: var(--leading-caption);
}

.legal-note {
  margin: var(--spacing-lg) var(--spacing-lg) 0;
  text-align: center;
  color: var(--color-ink-muted-48);
  font-size: var(--text-micro-legal);
  line-height: 1.3;
}
